# Copy to .env.local for local development. Never commit .env.local.
# See docs/ENVIRONMENT_VARIABLES.md for what each variable does and who owns it.

# --- Public (shipped to the browser; must never contain secrets) ---
# Local values come from `pnpm db:start` output.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server only (never prefix with NEXT_PUBLIC_) ---
# Bypasses Row-Level Security. Used only by audited server-side code paths.
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key

# --- Phase 5 (payments) — leave unset until the payment architecture is approved ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
